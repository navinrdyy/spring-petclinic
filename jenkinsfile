pipeline {
    agent any

    stages {
        stage('Hello') {
            steps {
                echo 'Hello World'
            }
        }
        stage('Build') {
            environment{
                DOCKER_IMAGE = "navinrdyy/mysql-db:${BUILD_NUMBER}"
                //DOCKERFILE_LOCATION = './mysql-Dockerfile'
                REGISTRY_CREDENTIALS = credentials('docker-cred')
            }
            steps {
                script{
                    sh 'docker build -t ${DOCKER_IMAGE} -f mysql-Dockerfile'
                     dockerImage = docker.image("${DOCKER_IMAGE}")
                    docker.withRegistry('https://index.docker.io/v1/','docker-cred'){ 
                        dockerImage.push()
                    }
                }
            }
            
        }
    }
}
