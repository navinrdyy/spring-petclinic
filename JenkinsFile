pipeline {
    agent {
        docker {
            image 'maven:3.9.6-eclipse-temurin-17'
            args '-v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    stages {
        stage('Hello') {
            steps {
                echo 'Hello World!'
            }
        }

        stage('Checkout') {
            steps {
                echo 'checkout passed'
            }
        }

        stage('Build and create Jar file') {
            steps {
                sh 'ls -ltr'
                // build the spring project
                sh 'mvn clean package'
            }
        }

        stage('Build and push image') {
            environment {
                DOCKER_IMAGE = "navinrdyy/springboot-petclinic:${BUILD_NUMBER}"
                DOCKERFILE_LOCATION = 'Dockerfile'
                REGISTRY_CREDENTIALS = credentials('docker-cred')
            }
            steps {
                script {
                    sh 'docker build -t ${DOCKER_IMAGE} .'
                    def dockerImage = docker.image("${DOCKER_IMAGE}")
                    docker.withRegistry('https://index.docker.io/v1/', "docker-cred") {
                        dockerImage.push()
                    }
                }
            }
        }

        stage('Update Deploymnet File') {
            environment {
                GIT_REPO_NAME = 'spring-petclinic'
                GIT_USER_NAME = 'navinrdyy'
            }
            steps {
                withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        git config user.email "naveenreddy1335@gmail.com"
                        git config user.name "navinrdyy"
                        BUILD_NUMBER=${BUILD_NUMBER}
                        sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" spring-boot-app-manifests/deployment.yml
                        git add spring-boot-app-manifests/deployment.yml
                        git commit -m "Update deployment image to version ${BUILD_NUMBER}"
                        git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:naveen
                    '''
                }
            }
        }
    }
}
